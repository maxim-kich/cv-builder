# Generate with: openssl rand -hex 32
CV_BUILDER_API_TOKEN=replace-with-a-long-random-token

# Browser/API origin. For local Docker use http://localhost:5173.
CV_BUILDER_PUBLIC_URL=http://localhost:5173
CV_BUILDER_PORT=5173
CV_BUILDER_SEED_FILE=none

# Required only by compose.postgres.yaml.
POSTGRES_PASSWORD=replace-with-a-different-long-random-password

# Required only by compose.remote.yaml. Point its A/AAAA record at the host.
CV_BUILDER_DOMAIN=cv.example.com
