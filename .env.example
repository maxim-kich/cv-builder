# Generate with: openssl rand -hex 32
CV_BUILDER_API_TOKEN=replace-with-a-long-random-token

# Browser/API origin. For local Docker use http://localhost:5173.
CV_BUILDER_PUBLIC_URL=http://localhost:5173
CV_BUILDER_PORT=5173
CV_BUILDER_SEED_FILE=none

# Hosted OAuth 2.1 / MCP. Use exact values from one trusted Auth0 tenant.
# Each CV Builder deployment uses its own audience and one allowed Auth0 `sub`.
CV_BUILDER_OAUTH_ISSUER=https://your-tenant.eu.auth0.com/
CV_BUILDER_OAUTH_AUDIENCE=https://cv.example.com/mcp
CV_BUILDER_OAUTH_JWKS_URL=https://your-tenant.eu.auth0.com/.well-known/jwks.json
CV_BUILDER_OAUTH_ALLOWED_SUBJECTS=auth0|replace-with-user-id
CV_BUILDER_OAUTH_ALGORITHMS=RS256
CV_BUILDER_OAUTH_MAX_TOKEN_LIFETIME_SECONDS=600

# Emergency access-token revocation. Keep empty normally. Values are a
# comma-separated jti list and/or a Unix timestamp cutoff.
CV_BUILDER_OAUTH_REVOKED_TOKEN_IDS=
CV_BUILDER_OAUTH_REVOKED_BEFORE=

# Optional RFC 7662 introspection. Set all three or leave all three empty.
CV_BUILDER_OAUTH_INTROSPECTION_URL=
CV_BUILDER_OAUTH_INTROSPECTION_CLIENT_ID=
CV_BUILDER_OAUTH_INTROSPECTION_CLIENT_SECRET=

# Required only by compose.postgres.yaml.
POSTGRES_PASSWORD=replace-with-a-different-long-random-password

# Required only by compose.remote.yaml. Point its A/AAAA record at the host.
CV_BUILDER_DOMAIN=cv.example.com
